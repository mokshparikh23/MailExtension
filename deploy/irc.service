# systemd unit for the native (non-Docker) deployment.
# Install to /etc/systemd/system/irc.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now irc
[Unit]
Description=Internal Remote Control relay
After=network.target

[Service]
WorkingDirectory=/opt/internal-remote-control/server
EnvironmentFile=/opt/internal-remote-control/server/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
User=www-data
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
